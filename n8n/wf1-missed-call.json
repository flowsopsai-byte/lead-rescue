  "name": "Lead Rescue — WF1 Missed call",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body;\nconst client = $('Get client').first().json;\nconst caller = b.From;\n\n// Doublon : même appelant déjà traité dans les dernières 24h\nconst recent = $('Check doublon').all().some(i => i.json.id);\nif (recent) return [];\n\n// Fixe français = pas de SMS possible\nconst isLandline = caller.startsWith('+33') && !/^\\+33[67]/.test(caller);\n\nconst token = Array.from({ length: 12 }, () => Math.floor(Math.random() * 16).toString(16)).join('');\nconst lien = `https://typebot.co/lead-rescue-l0avpfn?t=${token}`;\n\nconst sms = client.sms_template\n  .replaceAll('{entreprise}', client.name)\n  .replaceAll('{lien}', lien);\n\nreturn [{\n  json: {\n    client_id: client.id,\n    caller_phone: caller,\n    is_landline: isLandline,\n    status: isLandline ? 'landline' : 'missed',\n    token,\n    lien,\n    sms\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        -240
      ],
